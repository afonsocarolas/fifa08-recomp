+            println("\t{}(ctx, base);", next->name);
+            println("\treturn;");
+        }
+        else
+        {
+            fmt::println("Function at {:X} falls through to {:X}, which is not a function", fn.base, base);
+        }
+    }
 
     println("}}\n");
 
