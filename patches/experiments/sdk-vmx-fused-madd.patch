+    ctx.println("\t{}.u16[{}] = {}.u32[{}] > 0xFFFF ? 0xFFFF : (uint16_t){}.u32[{}];", ctx.v_temp(),
+                3 - i, ctx.v(ctx.insn.operands[2]), 3 - i, ctx.v(ctx.insn.operands[2]), 3 - i);
   }
+  ctx.println("\t{} = {};", ctx.v(ctx.insn.operands[0]), ctx.v_temp());
   return true;
 }
 
