@@ -27,6 +27,96 @@ namespace rex::thread {
 
 thread_local Fiber* Fiber::tls_current_ = nullptr;
 
+#if REX_PLATFORM_ANDROID
+#if !defined(__aarch64__)
+#error The Android fiber switch is only implemented for arm64-v8a.
+#endif
+
+// Saves the AArch64 callee-saved registers (x19-x30, d8-d15) on the current
+// stack, stores sp in *from_sp, loads to_sp and restores the same frame from
+// it. A new fiber's stack is prepared with such a frame whose x30 points at
+// rex_fiber_start, so the first switch "returns" into the trampoline.
+extern "C" void rex_fiber_switch(void** from_sp, void* to_sp);
+extern "C" void rex_fiber_start();
+
+asm(R"(
+  .text
+  .p2align 2
+  .global rex_fiber_switch
+  .type rex_fiber_switch, %function
+rex_fiber_switch:
+  sub  sp, sp, #160
+  stp  x19, x20, [sp, #0]
+  stp  x21, x22, [sp, #16]
+  stp  x23, x24, [sp, #32]
+  stp  x25, x26, [sp, #48]
+  stp  x27, x28, [sp, #64]
+  stp  x29, x30, [sp, #80]
+  stp  d8,  d9,  [sp, #96]
+  stp  d10, d11, [sp, #112]
+  stp  d12, d13, [sp, #128]
+  stp  d14, d15, [sp, #144]
+  mov  x2, sp
+  str  x2, [x0]
+  mov  sp, x1
+  ldp  x19, x20, [sp, #0]
+  ldp  x21, x22, [sp, #16]
+  ldp  x23, x24, [sp, #32]
+  ldp  x25, x26, [sp, #48]
+  ldp  x27, x28, [sp, #64]
+  ldp  x29, x30, [sp, #80]
+  ldp  d8,  d9,  [sp, #96]
+  ldp  d10, d11, [sp, #112]
+  ldp  d12, d13, [sp, #128]
+  ldp  d14, d15, [sp, #144]
+  add  sp, sp, #160
+  ret
+  .size rex_fiber_switch, .-rex_fiber_switch
+
+  .global rex_fiber_start
+  .type rex_fiber_start, %function
+rex_fiber_start:
+  mov  x29, #0
+  bl   rex_fiber_trampoline
+  brk  #0
+  .size rex_fiber_start, .-rex_fiber_start
+)");
+
+extern "C" void rex_fiber_trampoline() { Fiber::RunTrampoline(); }
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;  // sp_ is filled in by the first switch away
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+  // Initial frame at the 16-byte aligned top of the stack: all saved
+  // registers zero except x30 = rex_fiber_start.
+  uintptr_t top = (reinterpret_cast<uintptr_t>(f->stack_.data()) + stack_size) & ~uintptr_t(15);
+  auto* frame = reinterpret_cast<uint64_t*>(top - 160);
+  for (int i = 0; i < 20; ++i) frame[i] = 0;
+  frame[11] = reinterpret_cast<uint64_t>(&rex_fiber_start);  // x30 slot (offset 88)
+  f->sp_ = frame;
+  return f;
+}
+
+/*static*/ void Fiber::Trampoline() {
+  Fiber* f = tls_current_;
+  f->entry_(f->arg_);
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  tls_current_ = target;
+  rex_fiber_switch(&from->sp_, target->sp_);
+}
